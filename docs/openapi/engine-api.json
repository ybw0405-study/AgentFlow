{
  "components": {
    "schemas": {
      "DslError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "nodeKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nodekey"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "DslError",
        "type": "object"
      },
      "ExecuteRequest": {
        "additionalProperties": false,
        "properties": {
          "authorizedConnectorIds": {
            "items": {
              "type": "string"
            },
            "title": "Authorizedconnectorids",
            "type": "array"
          },
          "definitionId": {
            "title": "Definitionid",
            "type": "string"
          },
          "executionId": {
            "format": "uuid",
            "title": "Executionid",
            "type": "string"
          },
          "executionSeed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Executionseed"
          },
          "idempotencyKey": {
            "title": "Idempotencykey",
            "type": "string"
          },
          "initialVariables": {
            "additionalProperties": true,
            "title": "Initialvariables",
            "type": "object"
          },
          "policy": {
            "$ref": "#/components/schemas/PolicyIn",
            "default": {}
          },
          "preview": {
            "default": false,
            "title": "Preview",
            "type": "boolean"
          },
          "spaceId": {
            "title": "Spaceid",
            "type": "string"
          },
          "tenantId": {
            "title": "Tenantid",
            "type": "string"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          },
          "triggeredBy": {
            "title": "Triggeredby",
            "type": "string"
          },
          "versionId": {
            "title": "Versionid",
            "type": "string"
          },
          "versionSnapshot": {
            "additionalProperties": true,
            "title": "Versionsnapshot",
            "type": "object"
          }
        },
        "required": [
          "executionId",
          "definitionId",
          "versionId",
          "tenantId",
          "spaceId",
          "triggeredBy",
          "idempotencyKey",
          "versionSnapshot",
          "traceId"
        ],
        "title": "ExecuteRequest",
        "type": "object"
      },
      "GateResolveRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "decision": {
            "enum": [
              "APPROVED",
              "REJECTED",
              "TIMEOUT"
            ],
            "title": "Decision",
            "type": "string"
          },
          "resolvedBy": {
            "default": "",
            "title": "Resolvedby",
            "type": "string"
          }
        },
        "required": [
          "decision"
        ],
        "title": "GateResolveRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LlmModelItem": {
        "additionalProperties": false,
        "description": "单个模型的能力标注。字段拿不到就缺省，前端不显示空标签。",
        "properties": {
          "contextWindow": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contextwindow"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "maxOutputTokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxoutputtokens"
          },
          "source": {
            "default": "inferred",
            "enum": [
              "upstream",
              "inferred"
            ],
            "title": "Source",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "id"
        ],
        "title": "LlmModelItem",
        "type": "object"
      },
      "LlmModelsResponse": {
        "additionalProperties": false,
        "description": "可用模型清单。未配置真实端点时 configured=false，前端据此退回手填。",
        "properties": {
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "defaultModel": {
            "title": "Defaultmodel",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/LlmModelItem"
            },
            "title": "Items",
            "type": "array"
          },
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "configured",
          "defaultModel",
          "models"
        ],
        "title": "LlmModelsResponse",
        "type": "object"
      },
      "NodePreviewRequest": {
        "additionalProperties": false,
        "description": "单节点试跑：整份草稿 + 目标节点 + 本次要用的变量。\n\n传整份草稿而不是「节点配置」：试跑要把上游真实跑一遍，模板里引用的\n`nodes.xxx.output` 才有值，否则用户拿到的只是一个渲染失败。",
        "properties": {
          "authorizedConnectorIds": {
            "items": {
              "type": "string"
            },
            "title": "Authorizedconnectorids",
            "type": "array"
          },
          "dsl": {
            "additionalProperties": true,
            "title": "Dsl",
            "type": "object"
          },
          "nodeKey": {
            "title": "Nodekey",
            "type": "string"
          },
          "requestedBy": {
            "default": "preview",
            "title": "Requestedby",
            "type": "string"
          },
          "spaceId": {
            "default": "preview",
            "title": "Spaceid",
            "type": "string"
          },
          "tenantId": {
            "default": "preview",
            "title": "Tenantid",
            "type": "string"
          },
          "timeoutMs": {
            "default": 120000,
            "title": "Timeoutms",
            "type": "integer"
          },
          "tokenBudget": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tokenbudget"
          },
          "variables": {
            "additionalProperties": true,
            "title": "Variables",
            "type": "object"
          }
        },
        "required": [
          "dsl",
          "nodeKey"
        ],
        "title": "NodePreviewRequest",
        "type": "object"
      },
      "PolicyIn": {
        "additionalProperties": false,
        "properties": {
          "deadlineMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadlinems"
          },
          "maxSteps": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxsteps"
          },
          "tokenBudget": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tokenbudget"
          }
        },
        "title": "PolicyIn",
        "type": "object"
      },
      "ValidateRequest": {
        "additionalProperties": false,
        "properties": {
          "dsl": {
            "additionalProperties": true,
            "title": "Dsl",
            "type": "object"
          }
        },
        "required": [
          "dsl"
        ],
        "title": "ValidateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationResult": {
        "additionalProperties": false,
        "properties": {
          "checksum": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checksum"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/DslError"
            },
            "title": "Errors",
            "type": "array"
          },
          "normalizedDsl": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalizeddsl"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "ValidationResult",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "agentflow-engine",
    "version": "0.5.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/dsl/validate": {
      "post": {
        "operationId": "validate_internal_dsl_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Validate"
      }
    },
    "/internal/events": {
      "get": {
        "description": "事件尾读。AF-3：调用方带 spaceId 时，过滤条件下推到引擎 SQL 层，\n不再无条件返回全租户事件。空/空白视为未指定（系统级投影器走全局路径）。",
        "operationId": "tail_events_internal_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "after_seq",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After Seq",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "afterSeq",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Afterseq"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "spaceId",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Spaceid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Tail Events Internal Events Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tail Events"
      }
    },
