{
  "components": {
    "schemas": {
      "DslError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "nodeKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nodekey"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "DslError",
        "type": "object"
      },
      "ExecuteRequest": {
        "additionalProperties": false,
        "properties": {
          "authorizedConnectorIds": {
            "items": {
              "type": "string"
            },
            "title": "Authorizedconnectorids",
            "type": "array"
          },
          "definitionId": {
            "title": "Definitionid",
            "type": "string"
          },
          "executionId": {
            "format": "uuid",
            "title": "Executionid",
            "type": "string"
          },
          "executionSeed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Executionseed"
          },
          "idempotencyKey": {
            "title": "Idempotencykey",
            "type": "string"
          },
          "initialVariables": {
            "additionalProperties": true,
            "title": "Initialvariables",
            "type": "object"
          },
          "policy": {
            "$ref": "#/components/schemas/PolicyIn",
            "default": {}
          },
          "spaceId": {
            "title": "Spaceid",
            "type": "string"
          },
          "tenantId": {
            "title": "Tenantid",
            "type": "string"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          },
          "triggeredBy": {
            "title": "Triggeredby",
            "type": "string"
          },
          "versionId": {
            "title": "Versionid",
            "type": "string"
          },
          "versionSnapshot": {
            "additionalProperties": true,
            "title": "Versionsnapshot",
            "type": "object"
          }
        },
        "required": [
          "executionId",
          "definitionId",
          "versionId",
          "tenantId",
          "spaceId",
          "triggeredBy",
          "idempotencyKey",
          "versionSnapshot",
          "traceId"
        ],
        "title": "ExecuteRequest",
        "type": "object"
      },
      "GateResolveRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "decision": {
            "enum": [
              "APPROVED",
              "REJECTED",
              "TIMEOUT"
            ],
            "title": "Decision",
            "type": "string"
          },
          "resolvedBy": {
            "default": "",
            "title": "Resolvedby",
            "type": "string"
          }
        },
        "required": [
          "decision"
        ],
        "title": "GateResolveRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LlmModelsResponse": {
        "additionalProperties": false,
        "description": "可用模型清单。未配置真实端点时 configured=false，前端据此退回手填。",
        "properties": {
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "defaultModel": {
            "title": "Defaultmodel",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "configured",
          "defaultModel",
          "models"
        ],
        "title": "LlmModelsResponse",
        "type": "object"
      },
      "PolicyIn": {
        "additionalProperties": false,
        "properties": {
          "deadlineMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadlinems"
          },
          "maxSteps": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxsteps"
          },
          "tokenBudget": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tokenbudget"
          }
        },
        "title": "PolicyIn",
        "type": "object"
      },
      "ValidateRequest": {
        "additionalProperties": false,
        "properties": {
          "dsl": {
            "additionalProperties": true,
            "title": "Dsl",
            "type": "object"
          }
        },
        "required": [
          "dsl"
        ],
        "title": "ValidateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationResult": {
        "additionalProperties": false,
        "properties": {
          "checksum": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checksum"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/DslError"
            },
            "title": "Errors",
            "type": "array"
          },
          "normalizedDsl": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalizeddsl"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "ValidationResult",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "agentflow-engine",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/dsl/validate": {
      "post": {
        "operationId": "validate_internal_dsl_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Validate"
      }
    },
    "/internal/events": {
      "get": {
        "operationId": "tail_events_internal_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "after_seq",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After Seq",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "afterSeq",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Afterseq"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Tail Events Internal Events Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tail Events"
      }
    },
    "/internal/executions": {
      "post": {
        "operationId": "execute_internal_executions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecuteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Execute Internal Executions Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Execute"
      }
    },
    "/internal/executions/{execution_id}/cancel": {
      "post": {
        "operationId": "cancel_internal_executions__execution_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "execution_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Execution Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Cancel Internal Executions  Execution Id  Cancel Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel"
      }
    },
    "/internal/executions/{execution_id}/events": {
      "get": {
        "operationId": "execution_events_internal_executions__execution_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "execution_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Execution Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after_seq",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After Seq",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "afterSeq",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Afterseq"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Execution Events Internal Executions  Execution Id  Events Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Execution Events"
      }
    },
    "/internal/executions/{execution_id}/gates/{node_key}/resolve": {
      "post": {
        "description": "人工审批回调（P3）。幂等：重复裁决返回 ALREADY_RESOLVED。",
        "operationId": "resolve_gate_internal_executions__execution_id__gates__node_key__resolve_post",
        "parameters": [
          {
            "in": "path",
            "name": "execution_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Execution Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "node_key",
            "required": true,
            "schema": {
              "title": "Node Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GateResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Resolve Gate Internal Executions  Execution Id  Gates  Node Key  Resolve Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resolve Gate"
      }
    },
    "/internal/executions/{execution_id}/io/{node_key}": {
      "get": {
        "operationId": "node_io_internal_executions__execution_id__io__node_key__get",
        "parameters": [
          {
            "in": "path",
            "name": "execution_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Execution Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "node_key",
            "required": true,
            "schema": {
              "title": "Node Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Node Io Internal Executions  Execution Id  Io  Node Key  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Node Io"
      }
    },
    "/internal/executions/{execution_id}/state": {
      "get": {
        "operationId": "execution_state_internal_executions__execution_id__state_get",
        "parameters": [
          {
            "in": "path",
            "name": "execution_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Execution Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Execution State Internal Executions  Execution Id  State Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Execution State"
      }
    },
    "/internal/health": {
      "get": {
        "operationId": "health_internal_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Internal Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/internal/llm/models": {
      "get": {
        "description": "模型清单只对已配置的端点发起，密钥与 base_url 不出现在响应里。",
        "operationId": "llm_models_internal_llm_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmModelsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Llm Models"
      }
    },
    "/internal/metrics": {
      "get": {
        "operationId": "metrics_internal_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/internal/mq/status": {
      "get": {
        "description": "裁决 MQ 通道水位：连接状态、已消费/已应用/重复计数与最近错误。\n\n没有它就只能靠日志猜「MQ 到底有没有在工作」；e2e 也用它确认消费端真的连上了。",
        "operationId": "mq_status_internal_mq_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Mq Status Internal Mq Status Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Mq Status"
      }
    }
  }
}
