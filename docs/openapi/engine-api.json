    "/internal/health": {
      "get": {
        "description": "兼容别名（liveness）：进程存活即 200，README/既有探针口径不变。\n\nreadiness 请用 /health/ready —— 它会真探 PG + Redis，依赖 down 返回 503。",
        "operationId": "health_internal_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Internal Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/internal/health/live": {
      "get": {
        "description": "liveness（AF-8）：恒活，绝不因依赖抖动让编排器把存活实例摘除。",
        "operationId": "health_live_internal_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Live Internal Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Live"
      }
    },
    "/internal/health/ready": {
      "get": {
        "description": "readiness（AF-8）：短超时 SELECT 1 探 PG + Redis PING，任一 down 返回 503。\n\n与 Java 侧 HealthController 的 UP/DEGRADED 口径对齐；每个依赖独立探测，\n单次超时由 settings.health_probe_timeout_s 约束，不会拖住探针调用方。",
        "operationId": "health_ready_internal_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Ready"
      }
    },
    "/internal/llm/models": {
      "get": {
        "description": "模型清单只对已配置的端点发起，密钥与 base_url 不出现在响应里。\n\nmodels 是纯 id 列表（下拉框用），items 带能力标注（推理型、长上下文、输出上限），\n后者只用于界面提示，不参与任何执行决策。",
        "operationId": "llm_models_internal_llm_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmModelsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Llm Models"
      }
    },
    "/internal/metrics": {
      "get": {
