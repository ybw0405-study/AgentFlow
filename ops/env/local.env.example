# AgentFlow 本地开发 / 部署配置模板
#
# 用法：复制本文件为同目录下的 local.env（gitignored），按需填写后再注入进程环境。
# 键集合来自各服务 src/main/resources/application.yml 里的 ${AF_*:...} 占位符，
# 由 scripts/check_env_contract.py 对账，确保「application.yml 的 ${VAR} ⊆ 本文件键集合」。
# 非空值取 application.yml 的本地默认值；密钥类一律用明显占位符，切勿提交真实值。
# 值里的 # ? % @ $ 等都是字面量，不做行内注释剥离，不要给值加引号。
#
# AF_MYSQL_USER / AF_AUDIT_MYSQL_USER 在生产必须由环境显式注入最小权限账号
# （db/mysql/grants/least-privilege.sql）。application.yml 仍保留 root 作为**本地**
# dev 默认值（compose 只初始化了 root），但 AF-4 生产守卫会校验「实际生效的
# datasource username == 显式注入的账号且非 root」，未注入或被 --xxx 覆盖即拒绝启动。
# AF_ENGINE_INTERNAL_TOKEN 是网关→引擎的独立凭据（AF-3），生产必须与
# AF_INTERNAL_TOKEN 不同；未配置时网关注入控制面令牌，仅用于本地兼容。

# ===== 服务端口与内部地址 =====
AF_GATEWAY_PORT=8080
AF_WORKFLOW_PORT=8084
AF_CONNECTOR_PORT=8085
AF_AUDIT_PORT=8086
AF_ENGINE_SERVICE=http://127.0.0.1:8000
AF_WORKFLOW_SERVICE=http://127.0.0.1:8084
AF_CONNECTOR_SERVICE=http://127.0.0.1:8085
AF_AUDIT_SERVICE=http://127.0.0.1:8086
AF_GATEWAY_BASE=http://127.0.0.1:8080

# ===== MySQL =====
AF_MYSQL_HOST=127.0.0.1
AF_MYSQL_PORT=3307
# 生产必须显式注入最小权限账号（af_app）；本地 dev 可留空走 yml 的 root 默认值
AF_MYSQL_USER=
AF_MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
AF_MYSQL_USE_TLS=false
AF_MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
# 审计服务独立账号（af_audit）；生产按 db/mysql/grants/least-privilege.sql 收敛
AF_AUDIT_MYSQL_USER=CHANGE_ME_AUDIT_DB_USER

# ===== Redis =====
AF_REDIS_HOST=127.0.0.1
AF_REDIS_PORT=6379

# ===== RocketMQ 与审计链路 =====
AF_MQ_ENABLED=false
AF_ROCKETMQ_NAMESRV=127.0.0.1:9876
AF_ROCKETMQ_GATE_TOPIC=af-gate-decision
AF_AUDIT_SINK=auto
AF_AUDIT_DEAD_AFTER_ATTEMPTS=24
AF_AUDIT_DEGRADE_AFTER_ATTEMPTS=3
AF_AUDIT_PURGE_CRON=0 30 4 * * *
AF_AUDIT_PURGE_DAYS=7
AF_AUDIT_RELAY_INITIAL_DELAY_MS=4000
AF_AUDIT_RELAY_INTERVAL_MS=2000
AF_AUDIT_REPORT_INITIAL_DELAY_MS=60000
AF_AUDIT_REPORT_INTERVAL_MS=300000

# ===== 安全与凭据（示例值均为占位符）=====
AF_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN
# 网关→引擎入站专用：生产必须设置为与 AF_INTERNAL_TOKEN 不同的强值（AF-3 fail-fast）
AF_ENGINE_INTERNAL_TOKEN=CHANGE_ME_ENGINE_INTERNAL_TOKEN
AF_JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES
AF_JWT_TTL_SECONDS=900
AF_CRED_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
AF_CRED_MASTER_KEY_PREVIOUS=
AF_COOKIE_SECURE=true
AF_BCRYPT_STRENGTH=12
AF_REFRESH_TTL_DAYS=14
AF_RATE_LIMIT_LOGIN_MAX=10
AF_RATE_LIMIT_TRIGGER_MAX=20
AF_SANDBOX_ALLOW_HTTP=false
AF_SANDBOX_ALLOW_LOOPBACK=false
AF_AUTHORIZED_CONNECTORS=
AF_DEMO_ACCOUNTS=false

# ===== 执行 / 调度 / 看护 / 预算 =====
AF_DEFAULT_DEADLINE_MS=120000
AF_DEFAULT_MAX_STEPS=50
AF_DEFAULT_TOKEN_BUDGET=50000
AF_MONTHLY_CALL_LIMIT=10000
AF_MONTHLY_TOKEN_LIMIT=50000
AF_ENGINE_POLL_INTERVAL_MS=500
AF_EVAL_POLL_INTERVAL_MS=3000
AF_GATE_RELAY_INTERVAL_MS=5000
AF_REAP_ENABLED=true
AF_REAP_INITIAL_DELAY_MS=45000
AF_REAP_INTERVAL_MS=60000
AF_REAP_GRACE_MS=120000
AF_REAP_PENDING_GRACE_MS=180000
AF_REAP_BATCH=50
AF_REAP_UNREACHABLE_CONFIRMATIONS=3

# ===== 追踪导出（LangFuse，复用 DocQA 自托管实例，按 project 隔离）=====
# 实例由 DocQA compose 的 langfuse profile 提供，本仓库不新增任何基础设施。
# pk/sk 必须是 AgentFlow 专属 project 的密钥，不与 DocQA 混用。
AF_LANGFUSE_TRACING_ENABLED=false
AF_LANGFUSE_OTLP_ENDPOINT=http://127.0.0.1:13000/api/public/otel/v1/traces
AF_LANGFUSE_PUBLIC_KEY=CHANGE_ME_LANGFUSE_PUBLIC_KEY
AF_LANGFUSE_SECRET_KEY=CHANGE_ME_LANGFUSE_SECRET_KEY
# 非回环 endpoint 需显式置 true（Basic 凭据默认只发往本机）
AF_LANGFUSE_ALLOW_PRIVATE=false
# 执行详情 traceId 外链前缀（含 project 路径）；空 = 不下发链接
AF_LANGFUSE_BASE_URL=
