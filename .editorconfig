root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml}]
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{sql,yml,yaml,json}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4

[Makefile]
indent_style = tab
